{
  "name": "labbook",
  "version": "0.1.0",
  "private": true,
  "description": "Test-results lab book: define test types, submit runs, compare and chart them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/evaluate.test.ts test/openapi.test.ts",
    "test:integration": "vitest run test/api.test.ts test/baselines.test.ts",
    "start": "node dist/server/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.106.1",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "lucide-react": "1.70.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
